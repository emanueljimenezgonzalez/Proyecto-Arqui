# Copien este archivo como .env si el proyecto requiere configuración local.
# No coloquen claves reales en GitHub.
APP_ENV=development
REQUEST_TIMEOUT_SECONDS=20
MAX_CONCURRENT_GAMES=4
UPDATE_INTERVAL_MINUTES=360

# Buscador del Nintendo eShop que usa el scraper (pedir los valores al Integrante 1)
ESHOP_APP_ID=
ESHOP_API_KEY=
